---
import { getCollection } from 'astro:content';
import SampleTag from './SampleTag.astro';

interface Props {
  placement: string;
}
const { placement } = Astro.props;

const all = await getCollection('endorsements');
const match = all.filter((e) => e.data.placement === placement);
---

{
  match.map((e) => (
    <blockquote>
      {e.id.startsWith('sample') && <SampleTag label="Sample endorsement. Three real ones to be sourced" />}
      <p class="quote">{e.data.quote}</p>
      <footer>
        <span class="name">{e.data.name}</span>
        <span class="role">{e.data.title}, {e.data.organisation}</span>
      </footer>
    </blockquote>
  ))
}

<style>
  blockquote {
    position: relative;
    max-width: var(--measure);
  }
  .quote {
    font-size: 1.3em;
    line-height: 1.5;
    font-style: italic;
    text-wrap: pretty;
  }
  .quote::before {
    content: '\201C';
    display: block;
    font-size: 3.2em;
    line-height: 0.6;
    color: var(--teal-deep);
    margin-bottom: 0.35em;
  }
  footer {
    margin-top: 1.3rem;
    display: grid;
    gap: 0.15rem;
  }
  .name {
    font-family: var(--sans);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .role {
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
</style>
