---
import Base from '../layouts/Base.astro';
import SampleTag from '../components/SampleTag.astro';
---

<Base
  title="Contact. Reput8ion Dynamics"
  description="Talk to us directly. Email james@reput8ion.ie or call +353 86 388 3903. Dublin and Kildare."
>
  <article class="prose">
    <h1>Contact</h1>
    <p class="direct">
      <a href="mailto:james@reput8ion.ie">james@reput8ion.ie</a><br />
      <a href="tel:+353863883903">+353 86 388 3903</a>
    </p>
    <p data-placeholder>
      <SampleTag label="Response expectation. One line, set by James, then kept" />
      <span class="placeholder-block">We reply the same working day.</span>
    </p>
    <p>Based in Dublin and Kildare. We work wherever the problem is.</p>
  </article>
</Base>

<style>
  article {
    margin-top: 2rem;
  }
  article h1 {
    margin-bottom: 1.75rem;
  }
  .direct {
    font-size: 1.45em;
    line-height: 1.9;
  }
  .direct + p {
    margin-top: 1.75rem;
  }
</style>
