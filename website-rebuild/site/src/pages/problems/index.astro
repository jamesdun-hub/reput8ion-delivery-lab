---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const problems = (await getCollection('problems')).sort(
  (a, b) => a.data.order - b.data.order
);
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base
  title="Problems. Reput8ion Dynamics"
  description="The problems we are asked to fix: narrative, issues with a long fuse, senior delivery, board alignment and the four-hour call."
>
  <section class="band--dark page-head">
    <span class="ghost-num">P</span>
    <div class="container">
      <p class="eyebrow">Problems</p>
      <h1>The work, as clients describe it.</h1>
      <p class="lead">
        Not a services menu. If one of these sounds like the conversation
        happening in your organisation, start there.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <ol class="list">
        {
          problems.map((p, i) => (
            <li class="reveal">
              <a href={`/problems/${p.id}`}>
                <span class="num">{pad(i + 1)}</span>
                <span class="body">
                  <span class="title">{p.data.title} <span class="arrow">&rarr;</span></span>
                  <span class="summary">{p.data.summary}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .page-head .lead {
    margin-top: 1.2rem;
    max-width: 52ch;
  }
  .list {
    list-style: none;
    border-top: 1px solid var(--hairline);
  }
  .list a {
    display: grid;
    grid-template-columns: clamp(3.5rem, 8vw, 6.5rem) 1fr;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: center;
    padding: clamp(1.8rem, 3.5vw, 2.6rem) clamp(0.75rem, 2vw, 1.75rem);
    border-bottom: 1px solid var(--hairline);
    color: var(--ink);
    background-image: none;
    transition: background 0.22s ease, color 0.22s ease;
  }
  .list a:hover {
    background: var(--dark);
    color: var(--on-dark);
  }
  .num {
    font-family: var(--sans);
    font-size: clamp(1.3rem, 2.5vw, 2rem);
    font-weight: 700;
    color: transparent;
    -webkit-text-stroke: 1px var(--teal-deep);
  }
  .list a:hover .num {
    color: var(--accent);
    -webkit-text-stroke-color: var(--accent);
  }
  .title {
    display: block;
    font-size: clamp(1.4rem, 1.1rem + 1.6vw, 2.3rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .title .arrow {
    display: inline-block;
    color: var(--teal-deep);
    transition: transform 0.22s ease, color 0.22s ease;
  }
  .list a:hover .arrow {
    transform: translateX(6px);
    color: var(--accent);
  }
  .summary {
    display: block;
    margin-top: 0.5rem;
    color: var(--ink-soft);
    max-width: 62ch;
    transition: color 0.22s ease;
  }
  .list a:hover .summary {
    color: var(--on-dark-muted);
  }
</style>
