---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SampleTag from '../../components/SampleTag.astro';
import samples from '../../data/samples.json';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter((n) => !n.data.draft);
  return notes.map((n) => ({ params: { slug: n.id }, props: { entry: n } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const isSample = samples.notes.includes(entry.id);

const dateFmt = new Intl.DateTimeFormat('en-IE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Base
  title={`${entry.data.title}. Reput8ion Dynamics`}
  description={entry.data.standfirst}
>
  <section class="band--dark page-head">
    <div class="container--narrow">
      <p class="eyebrow">Note</p>
      {isSample && <SampleTag label="Sample note showing length and register. James banks three real ones before launch" />}
      <h1>{entry.data.title}</h1>
      <p class="meta date">{dateFmt.format(entry.data.date)}</p>
    </div>
  </section>

  <section class="band">
    <div class="container--narrow">
      <article class="prose note-body">
        <Content />
      </article>
      <p class="foot prose">
        If this is close to a problem you are carrying, <a href="/contact">talk to us</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-block: clamp(3rem, 6vw, 5rem);
  }
  .page-head h1 {
    max-width: 20ch;
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.2rem);
  }
  .date {
    margin-top: 1.1rem;
  }
  .note-body {
    line-height: 1.75;
  }
  .note-body :global(p:first-of-type) {
    font-size: 1.18em;
    line-height: 1.6;
  }
  .foot {
    margin-top: 3rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--hairline);
  }
</style>
