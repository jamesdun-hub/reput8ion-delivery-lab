---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SampleTag from '../../components/SampleTag.astro';
import samples from '../../data/samples.json';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter((n) => !n.data.draft);
  return notes.map((n) => ({ params: { slug: n.id }, props: { entry: n } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const isSample = samples.notes.includes(entry.id);

const dateFmt = new Intl.DateTimeFormat('en-IE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Base
  title={`${entry.data.title}. Reput8ion Dynamics`}
  description={entry.data.standfirst}
>
  <article>
    {isSample && <SampleTag label="Sample note showing length and register. James banks three real ones before launch" />}
    <h1>{entry.data.title}</h1>
    <p class="small date">{dateFmt.format(entry.data.date)}</p>
    <div class="prose note-body">
      <Content />
    </div>
    <hr class="rule" />
    <p class="prose small">
      If this is close to a problem you are carrying, <a href="/contact">talk to us</a>.
    </p>
  </article>
</Base>

<style>
  article {
    margin-top: 2rem;
  }
  h1 {
    max-width: 22ch;
  }
  .date {
    margin-top: 0.75rem;
  }
  .note-body {
    margin-top: 2.25rem;
    line-height: 1.7;
  }
</style>
