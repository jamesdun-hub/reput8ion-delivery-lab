---
import Base from '../layouts/Base.astro';
import SampleTag from '../components/SampleTag.astro';
---

<Base
  title="How we use AI. Reput8ion Dynamics"
  description="Our policy on the use of AI in client work."
>
  <section class="band--dark page-head">
    <div class="container">
      <p class="eyebrow">Policy</p>
      <h1>How we use AI.</h1>
    </div>
  </section>

  <section class="band">
    <div class="container--narrow prose">
      <SampleTag label="Carried-over page. Paste the existing AI use policy here verbatim, em dashes stripped" />
      <p class="placeholder-block" data-placeholder>
        The AI use policy carries over from the current site as a discretion
        signal. The existing text replaces this placeholder unchanged apart
        from the house style pass.
      </p>
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-block: clamp(3rem, 6vw, 5rem);
  }
</style>
